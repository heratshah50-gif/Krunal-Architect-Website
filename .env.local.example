# Copy this file to .env.local and fill in real values once you've created
# a Sanity project and a Resend account (see README.md "Next phases").
# Until these are set, the site runs fine using the placeholder content in
# src/lib/data/ and the contact form saves locally to data/inquiries.json.

# --- Sanity (sanity.io/manage) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Editor-permission token, used server-side only (contact form + seed script). Never expose this publicly.
SANITY_API_WRITE_TOKEN=

# --- Resend (resend.com) ---
RESEND_API_KEY=
# Must be a domain verified in Resend, e.g. notifications@ksarchitects.in
RESEND_FROM_EMAIL=

# --- Contact form ---
NOTIFY_EMAIL=asitarch@gmail.com

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.ksarchitects.in
